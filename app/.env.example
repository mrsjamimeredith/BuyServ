# Create a Pinterest app at https://developers.pinterest.com/apps/
# Enable "Read users, Read/Write pins, Read boards" scopes.
# Set the redirect URI in your Pinterest app to match REDIRECT_URI below.

PINTEREST_CLIENT_ID=your_app_id_here
PINTEREST_CLIENT_SECRET=your_app_secret_here
REDIRECT_URI=http://localhost:3000/auth/callback

# Session cookie secret. Use any random string.
SESSION_SECRET=change_me_to_something_random

# Server port
PORT=3000

# Pinterest app credentials (https://developers.pinterest.com/apps/)
# Required for OAuth + posting.
PINTEREST_CLIENT_ID=your_app_id_here
PINTEREST_CLIENT_SECRET=your_app_secret_here
REDIRECT_URI=http://localhost:3000/auth/callback

# REQUIRED. Used for: session signing, secret encryption at rest (AES-GCM).
# MUST be at least 16 chars. If you change/lose this, stored tokens can't be decrypted.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=change_me_to_a_long_random_string

# Optional. Required for AI image generation (prompt -> PNG).
# Midjourney has no official API; leaving that provider out on purpose.
OPENAI_API_KEY=

# Server
PORT=3000
NODE_ENV=development
